# ==========================================
# FLOWSCRIBE ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. DATABASE (Prisma / Supabase)
# ------------------------------------------
# If using local Supabase (npx supabase start), the default local URL is below.
# If using live Supabase, replace with your live connection string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ------------------------------------------
# 2. SUPABASE (Auth & Storage)
# ------------------------------------------
# Find these in your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="<YOUR_SUPABASE_PROJECT_URL_GOES_HERE>"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY_GOES_HERE>"
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY_GOES_HERE>"

# ------------------------------------------
# 3. AI / LLM Integration
# ------------------------------------------
# Required for analyzing the flowchart images
GEMINI_API_KEY="<YOUR_GEMINI_API_KEY_GOES_HERE>"

# ------------------------------------------
# 4. INTERNAL ROUTING
# ------------------------------------------
# Where the Vite frontend (7000) looks for the Next.js middleware
VITE_API_URL="http://localhost:6000"

# Where the Next.js middleware (6000) looks for the Node backend
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
