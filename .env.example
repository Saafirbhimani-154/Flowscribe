# ==========================================
# FLOWSCRIBE ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. DATABASE (Prisma / PostgreSQL)
# ------------------------------------------
# Default local Docker connection string:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ------------------------------------------
# 2. STORAGE (Google Drive API)
# ------------------------------------------
# Required for storing images (since we dropped Supabase Storage)
GOOGLE_DRIVE_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID_GOES_HERE>"
GOOGLE_DRIVE_CLIENT_SECRET="<YOUR_GOOGLE_CLIENT_SECRET_GOES_HERE>"
GOOGLE_DRIVE_REFRESH_TOKEN="<YOUR_GOOGLE_REFRESH_TOKEN_GOES_HERE>"

# ------------------------------------------
# 3. AI / LLM Integration
# ------------------------------------------
# Required for analyzing the flowchart images
GEMINI_API_KEY="<YOUR_GEMINI_API_KEY_GOES_HERE>"

# ------------------------------------------
# 4. INTERNAL ROUTING
# ------------------------------------------
# Where the Vite frontend (7000) looks for the Next.js middleware
VITE_API_URL="http://localhost:6000"

# Where the Next.js middleware (6000) looks for the Node backend
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
