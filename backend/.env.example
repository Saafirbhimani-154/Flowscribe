# ==========================================
# FLOWSCRIBE BACKEND ENVIRONMENT VARIABLES
# ==========================================

# --- General ---
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# --- PostgreSQL ---
POSTGRES_USER=POSTGRES_USER_NAME
POSTGRES_PASSWORD="<YOUR_DB_PASSWORD_HERE>"
POSTGRES_DB=POSTGRES_DB_NAME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Database to connect to initially (for creating the target DB)
POSTGRES_INIT_DB=

# Prisma connection string (built from above variables)
DATABASE_URL="postgresql://POSTGRES_USER_NAME:<YOUR_DB_PASSWORD_HERE>@db:5432/POSTGRES_DB_NAME"

# --- Storage (Google Drive) ---
GOOGLE_DRIVE_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID_GOES_HERE>"
GOOGLE_DRIVE_CLIENT_SECRET="<YOUR_GOOGLE_CLIENT_SECRET_GOES_HERE>"
GOOGLE_DRIVE_REFRESH_TOKEN="<YOUR_GOOGLE_REFRESH_TOKEN_GOES_HERE>"

# --- AI / LLM Integration (OpenRouter) ---
OPENROUTER_API_KEY="<YOUR_OPENROUTER_API_KEY_GOES_HERE>"

# --- pgAdmin (Visual Database Manager) ---
# This is the login you will use to enter the pgAdmin web UI at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=DEFAULT_EMAIL_FOR_PGADMIN
PGADMIN_DEFAULT_PASSWORD=DEFAULT_PASSWORD_FOR_PGADMIN
